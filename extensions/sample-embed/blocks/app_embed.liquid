{% # theme-check-disable %}

{%- if block.settings.enabled -%}
  <div
    class="sample-app-embed-banner"
    style="
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 9999;
      padding: 12px 16px;
      text-align: center;
      font-size: 15px;
      font-weight: 600;
      background: {{ block.settings.background }};
      color: {{ block.settings.text_colour }};
    "
  >
    {{ block.settings.banner }}
  </div>

  <script>
    // Injected by the app embed block, not by the theme.
    console.log(
      "[sample-embed] app embed active on {{ shop.permanent_domain }}"
    );
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sample Embed",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the banner",
      "default": true
    },
    {
      "type": "text",
      "id": "banner",
      "label": "Banner message",
      "default": "Injected by the sample app's theme app extension"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_colour",
      "label": "Text colour",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
